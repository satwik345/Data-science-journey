        )

    with col3:
        st.metric("Services", "6")

    st.divider()

    st.subheader("Our Services")

    c1, c2, c3 = st.columns(3)

    c1.info("📝 Create a new bank account")
    c2.info("💰 Deposit and withdraw money")
    c3.info("📊 View account and transaction details")


# ==========================================
# CREATE ACCOUNT
# ==========================================

elif menu == "Create Account":

    st.subheader("📝 Create New Account")

    with st.form("create_account_form"):

        name = st.text_input("Full Name")

        age = st.number_input(
            "Age",
            min_value=1,
            max_value=120,
            step=1
        )

        email = st.text_input("Email Address")

        phone = st.text_input("Phone Number")

        pin = st.text_input(
            "Create 4 Digit PIN",
            type="password",
            max_chars=4
        )

        submitted = st.form_submit_button(
            "Create Account",
            use_container_width=True
        )

        if submitted:

            success, result = Bank.create_account(
                name, int(age), email, phone, pin
            )

            if success:

                st.success(result)

                st.subheader("Account Created!")

                st.write(f"**Name:** {result['name']}")

                st.write(
                    f"**Account Number:** "
                    f"`{result['account_number']}`"
                )

                st.info(
                    "Please save your account number. "
                    "You will need it to log in."
                )

            else:
                st.error(result)


# ==========================================
# LOGIN
# ==========================================

elif menu == "Login":

    st.subheader("🔐 Account Login")

    with st.form("login_form"):

        acc_num = st.text_input("Account Number")

        pin = st.text_input(
            "4 Digit PIN",
            type="password",
            max_chars=4
        )

        login = st.form_submit_button(
            "Login",
            use_container_width=True
        )

        if login:

            account = Bank.authenticate(acc_num.strip(), pin)

            if account:

                st.session_state.logged_in = True
                st.session_state.account_number = acc_num.strip()

                st.success("Login successful!")

                st.rerun()

            else:
                st.error("Invalid account number or PIN.")


# ==========================================
# AUTHENTICATED PAGES
# ==========================================

elif st.session_state.logged_in:

    account = get_current_account()

    if account is None:

        st.session_state.logged_in = False
        st.session_state.account_number = None

        st.error("Account not found. Please log in again.")
        st.rerun()

    # --------------------------------------
    # DASHBOARD
    # --------------------------------------

    if menu == "Dashboard":

        st.subheader(f"Welcome, {account['name']} 👋")

        st.write(
            f"Account Number: `{account['account_number']}`"
        )

        c1, c2, c3 = st.columns(3)

        with c1:
            st.metric(
                "Available Balance",
                f"₹{account['balance']:,}"
            )

        with c2:
            st.metric("Account Age", f"{account['age']} years")

        with c3:
            st.metric(
                "Transactions",
                len(account["transactions"])
            )

        st.divider()

        st.subheader("Account Information")

        st.write(f"**Name:** {account['name']}")
        st.write(f"**Email:** {account['mail_id']}")
        st.write(f"**Phone:** {account['phone_number']}")

    # --------------------------------------
    # DEPOSIT
    # --------------------------------------

    elif menu == "Deposit Money":

        st.subheader("💰 Deposit Money")

        st.metric(
            "Current Balance",
            f"₹{account['balance']:,}"
        )

        with st.form("deposit_form"):

            amount = st.number_input(
                "Enter Deposit Amount",
                min_value=1,
                max_value=100000,
                step=100
            )

            submitted = st.form_submit_button(
                "Deposit",
                use_container_width=True
            )

            if submitted:

                success, message = Bank.deposit(account, amount)

                if success:
                    st.success(message)
                    st.rerun()
                else:
                    st.error(message)

    # --------------------------------------
    # WITHDRAW
    # --------------------------------------

    elif menu == "Withdraw Money":

        st.subheader("💸 Withdraw Money")

        st.metric(
            "Current Balance",
            f"₹{account['balance']:,}"
        )

        if account["balance"] > 0:

            with st.form("withdraw_form"):

                amount = st.number_input(
                    "Enter Withdrawal Amount",
                    min_value=1,
                    max_value=account["balance"],
                    step=100
                )

                submitted = st.form_submit_button(
                    "Withdraw",
                    use_container_width=True
                )

                if submitted:

                    success, message = Bank.withdraw(
                        account, amount
                    )

                    if success:
                        st.success(message)
                        st.rerun()
                    else:
                        st.error(message)

        else:
            st.warning("Your account has insufficient balance.")

    # --------------------------------------
    # TRANSACTION HISTORY
    # --------------------------------------

    elif menu == "Transaction History":

        st.subheader("📊 Transaction History")

        transactions = account["transactions"]

        if transactions:

            st.dataframe(
                transactions,
                use_container_width=True,
                hide_index=True
            )

        else:
            st.info("No transactions found.")

    # --------------------------------------
    # UPDATE ACCOUNT
    # --------------------------------------

    elif menu == "Update Account":

        st.subheader("⚙️ Update Account Details")

        with st.form("update_form"):

            name = st.text_input(
                "Name",
                value=account["name"]
            )

            email = st.text_input(
                "Email",
                value=account["mail_id"]
            )

            phone = st.text_input(
                "Phone Number",
                value=account["phone_number"]
            )

            pin = st.text_input(
                "New PIN",
                type="password",
                max_chars=4
            )

            submitted = st.form_submit_button(
                "Update Details",
                use_container_width=True
            )

            if submitted:

                success, message = Bank.update_account(
                    account,
                    name,
                    email,
                    phone,
                    pin
                )

                if success:
                    st.success(message)
                    st.rerun()
                else:
                    st.error(message)

    # --------------------------------------
    # DELETE ACCOUNT
    # --------------------------------------

    elif menu == "Delete Account":

        st.subheader("⚠️ Delete Account")

        st.warning(
            "Deleting your account will permanently remove "
            "your account information and transaction history."
        )

        confirmation = st.checkbox(
            "I understand and want to delete my account."
        )

        if st.button(
            "Delete My Account",
            type="primary",
            disabled=not confirmation
        ):

            Bank.delete_account(account)

            st.session_state.logged_in = False
            st.session_state.account_number = None

            st.success("Account deleted successfully!")

            st.rerun()


# ==========================================
# LOGIN REQUIRED
# ==========================================

else:

    st.info("Please create an account or log in to access banking services.")


