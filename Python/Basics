    "# Prime numbers up to n\n",
    "def prime_generator(n):\n",
    "    for num in range(2, n + 1):\n",
    "        is_prime = True\n",
    "        for i in range(2, int(num**0.5) + 1):\n",
    "            if num % i == 0:\n",
    "                is_prime = False\n",
    "                break\n",
    "        if is_prime:\n",
    "            yield num\n",
    "\n",
    "for i in prime_generator(20):\n",
    "    print(i,end=\" \")"
