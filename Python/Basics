   "source": "### **mini project on file handling in python**",
   "id": "c0feecd85dbf80b7"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-02T06:01:16.976375300Z",
     "start_time": "2026-11-02T06:01:00.542987500Z"
    }
   },
   "cell_type": "code",
   "source": [
    "from pathlib import Path\n",
    "import os\n",
    "\n",
    "def read_file_folder():\n",
    "    path = Path(\"\")\n",
    "    items = list(path.rglob(\"*.txt\"))\n",
    "    for i,items in enumerate(items):\n",
    "        print(f\"{i+1}. {items}\")\n",
    "\n",
    "def create_file():\n",
    "    try:\n",
    "        print(\"The Files in the current directory are:\")\n",
    "        read_file_folder()\n",
    "        name = input(\"Enter the name of the file to be created: \")\n",
    "        p = Path(name)\n",
    "        if p.exists():\n",
    "            print(\"File already exists\")\n",
    "        else:\n",
    "             with open(p,\"w\") as fs:\n",
    "                data = input(\"Enter the content of the file: \")\n",
    "                fs.write(data+\"\\n\")\n",
    "             print(f\"File {name} created successfully\")\n",
    "        print(\"The Files in the current directory are:\")\n",
    "        read_file_folder()\n",
    "\n",
    "    except Exception as err:\n",
    "        print(f\"Error: {err}\")\n",
    "\n",
    "def read_file():\n",
    "    try:\n",
    "        print(\"The Files in the current directory are:\")\n",
    "        read_file_folder()\n",
    "        name = input(\"Enter the name of the file to be read: \")\n",
    "        p = Path(name)\n",
    "        if p.exists() and p.is_file():\n",
    "            print(f\"Content of the file {name} is:\\n\")\n",
    "            with open(p,\"r\") as fs:\n",
    "                for line in fs:\n",
    "                    print(line,end=\"\")\n",
    "        else:\n",
    "            print(\"File not found or inaccessible.\")\n",
    "    except Exception as err:\n",
    "        print(f\"Error: {err}\")\n",
    "\n",
    "def update_file():\n",
    "    try:\n",
    "        print(\"The Files in the current directory are:\")\n",
