import streamlit as st
import json
import random
import string
from pathlib import Path
from datetime import datetime


# ==========================================
# BANK CLASS
# ==========================================

class Bank:

    database = "bank_data.json"
    data = []

    # Load database
    @classmethod
    def load_data(cls):

        if Path(cls.database).exists():
            try:
                with open(cls.database, "r") as fs:
                    loaded = json.load(fs)

                if not isinstance(loaded, list):
                    raise ValueError("Invalid database format")

                cls.data = loaded

                # Support accounts created using the earlier version
                for account in cls.data:
                    account["pin"] = str(
                        account.get("pin", account.get("Pin:", ""))
                    )
                    account["phone_number"] = str(
                        account.get("phone_number",
                                   account.get("Phone_number", ""))
                    )
                    account.setdefault("transactions", [])

            except (json.JSONDecodeError, OSError, ValueError) as err:
                st.error(f"Database loading error: {err}")
                cls.data = []
        else:
            cls.data = []

    # Save database
    @classmethod
    def update(cls):

        try:
            with open(cls.database, "w") as fs:
                json.dump(cls.data, fs, indent=4)
        except OSError as err:
            st.error(f"Database saving error: {err}")

    # Generate unique account number
    @classmethod
    def account_generation(cls):

        while True:

            alpha = random.choices(string.ascii_uppercase, k=5)
            digits = random.choices(string.digits, k=5)

            account_number = "".join(alpha + digits)

            if not any(
                account["account_number"] == account_number
                for account in cls.data
            ):
                return account_number

    # Create account
    @classmethod
    def create_account(cls, name, age, email, phone, pin):

        if not name.strip():
            return False, "Name cannot be empty."

        if not 18 <= age <= 100:
            return False, "Age must be between 18 and 100."

        if "@" not in email or "." not in email:
            return False, "Enter a valid email address."

        if not (phone.isdigit() and len(phone) == 10):
            return False, "Phone number must contain 10 digits."

        if not (pin.isdigit() and len(pin) == 4):
            return False, "PIN must contain exactly 4 digits."

        account = {
            "name": name.strip(),
            "age": age,
            "mail_id": email,
            "phone_number": phone,
            "account_number": cls.account_generation(),
            "pin": pin,
            "balance": 0,
            "transactions": []
        }

        cls.data.append(account)
        cls.update()

        return True, account

    # Authenticate account
    @classmethod
    def authenticate(cls, acc_num, pin):

        for account in cls.data:

            if (
                account["account_number"] == acc_num
                and account["pin"] == pin
            ):
                return account

        return None

    # Deposit money
    @classmethod
    def deposit(cls, account, amount):

        if amount <= 0:
            return False, "Enter a positive amount."

        if amount > 100000:
            return False, "Maximum deposit is ₹1,00,000."

        account["balance"] += amount

        account["transactions"].append({
            "type": "Deposit",
            "amount": amount,
            "date": datetime.now().strftime("%d-%m-%Y %H:%M:%S"),
            "balance": account["balance"]
        })

        cls.update()

        return True, "Money deposited successfully!"

    # Withdraw money
    @classmethod
    def withdraw(cls, account, amount):

        if amount <= 0:
            return False, "Enter a positive amount."

        if amount > account["balance"]:
            return False, "Insufficient balance."

        account["balance"] -= amount

        account["transactions"].append({
            "type": "Withdrawal",
            "amount": amount,
            "date": datetime.now().strftime("%d-%m-%Y %H:%M:%S"),
            "balance": account["balance"]
        })

        cls.update()

        return True, "Money withdrawn successfully!"

    # Update account
    @classmethod
    def update_account(cls, account, name, email, phone, pin):

        if not name.strip():
            return False, "Name cannot be empty."

        if "@" not in email or "." not in email:
            return False, "Enter a valid email."

        if not (phone.isdigit() and len(phone) == 10):
            return False, "Phone number must contain 10 digits."

        if not (pin.isdigit() and len(pin) == 4):
            return False, "PIN must contain 4 digits."

        account["name"] = name.strip()
        account["mail_id"] = email
        account["phone_number"] = phone
        account["pin"] = pin

        cls.update()

        return True, "Account updated successfully!"

    # Delete account
    @classmethod
    def delete_account(cls, account):

        cls.data.remove(account)
        cls.update()


