    "            students.append({ \"id\": new_student_id, \"name\": new_student_name, \"marks\": new_student_marks})\n",
    "            print(\"Student added successfully\")\n",
    "        else:\n",
    "            print(\"Cancelled\")\n",
    "            return\n",
    "\n",
    "    except ValueError as e:\n",
    "        print(\"Error:\", e)\n",
    "\n",
    "def remove_student():\n",
    "    try:\n",
    "        basis = input(\"What basis to remove (id/name)? \").lower()\n",
    "\n",
