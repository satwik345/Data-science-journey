    "            for student in students:\n",
    "                if student[\"name\"] == student_name:\n",
    "                    if confirmation():\n",
    "                         students.remove(student)\n",
    "                         print(\"Removed successfully\")\n",
    "                         return\n",
    "                    else:\n",
    "                         print(\"Deletion cancelled\")\n",
    "                         return\n",
    "\n",
    "        else:\n",
    "            raise ValueError(\"Invalid basis\")\n",
    "\n",
    "        print(\"Student not found\")\n",
    "\n",
    "    except ValueError as e:\n",
    "        print(\"Error:\", e)\n",
    "\n",
    "def updating_students():\n",
    "    try:\n",
    "        update_basis = input(\"What do you want to update (id/name/marks)? \").lower()\n",
    "\n",
    "        if update_basis == \"id\":\n",
    "            current_student_id = int(input(\"Enter current student ID: \"))\n",
    "            further_student_id = int(input(\"Enter new student ID: \"))\n",
